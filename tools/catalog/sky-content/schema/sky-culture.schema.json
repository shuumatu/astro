{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astro.local/schemas/sky-culture.schema.json",
  "title": "SkyCulturePack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "names",
    "defaultLanguage",
    "descriptions",
    "sources",
    "starNames",
    "figures",
    "groups",
    "regions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/version" },
    "names": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/name" }
    },
    "defaultLanguage": { "$ref": "#/$defs/language" },
    "descriptions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/localizedText" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "starNames": {
      "type": "array",
      "items": { "$ref": "#/$defs/starNameRecord" }
    },
    "figures": {
      "type": "array",
      "items": { "$ref": "#/$defs/figure" }
    },
    "groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/group" }
    },
    "regions": {
      "type": "array",
      "items": { "$ref": "#/$defs/region" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "objectId": {
      "type": "string",
      "pattern": "^HIP:[1-9][0-9]*$"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "value", "type", "preferred", "searchable", "sourceId"],
      "properties": {
        "language": { "$ref": "#/$defs/language" },
        "value": { "type": "string", "minLength": 1 },
        "type": {
          "enum": ["native", "official", "translation", "transliteration", "alias"]
        },
        "preferred": { "type": "boolean" },
        "searchable": { "type": "boolean" },
        "sourceId": { "$ref": "#/$defs/sourceId" }
      }
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "value", "sourceId"],
      "properties": {
        "language": { "$ref": "#/$defs/language" },
        "value": { "type": "string", "minLength": 1 },
        "sourceId": { "$ref": "#/$defs/sourceId" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "authors", "url", "version", "license", "attribution"],
      "properties": {
        "id": { "$ref": "#/$defs/sourceId" },
        "title": { "type": "string", "minLength": 1 },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "url": { "type": "string", "format": "uri" },
        "version": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "attribution": { "type": "string", "minLength": 1 }
      }
    },
    "starNameRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectId", "labelPriority", "names"],
      "properties": {
        "objectId": { "$ref": "#/$defs/objectId" },
        "labelPriority": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "names": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/name" }
        }
      }
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "names",
        "paths",
        "labelAnchor",
        "rank",
        "groupIds",
        "sourceIds"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["constellation", "asterism", "enclosure-wall", "lunar-mansion"] },
        "iauCode": { "type": "string", "pattern": "^[A-Z][A-Za-z]{2}$" },
        "names": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/name" }
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/objectId" }
          }
        },
        "labelAnchor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["objectId"],
          "properties": { "objectId": { "$ref": "#/$defs/objectId" } }
        },
        "rank": { "type": "integer", "minimum": 1, "maximum": 3 },
        "groupIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" }
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceId" }
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "names", "members", "sourceIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["system", "enclosure", "lunar-mansions", "constellation-set"] },
        "names": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/name" }
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "id"],
            "properties": {
              "type": { "enum": ["figure", "group"] },
              "id": { "$ref": "#/$defs/id" }
            }
          }
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceId" }
        }
      }
    },
    "position": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "multiPolygon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "MultiPolygon" },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 4,
              "items": { "$ref": "#/$defs/position" }
            }
          }
        }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "figureId", "names", "referenceFrame", "geometry", "sourceIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "figureId": { "$ref": "#/$defs/id" },
        "names": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/name" }
        },
        "referenceFrame": { "const": "ICRS" },
        "geometry": { "$ref": "#/$defs/multiPolygon" },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceId" }
        }
      }
    }
  }
}
