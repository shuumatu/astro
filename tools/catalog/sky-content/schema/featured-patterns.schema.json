{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astro.local/schemas/featured-patterns.schema.json",
  "title": "FeaturedPatternPack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "sources", "patterns"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "featured-patterns" },
    "version": { "$ref": "#/$defs/version" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pattern" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "language": { "type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" },
    "objectId": { "type": "string", "pattern": "^HIP:[1-9][0-9]*$" },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "value", "type", "preferred", "searchable", "sourceId"],
      "properties": {
        "language": { "$ref": "#/$defs/language" },
        "value": { "type": "string", "minLength": 1 },
        "type": { "enum": ["native", "official", "translation", "transliteration", "alias"] },
        "preferred": { "type": "boolean" },
        "searchable": { "type": "boolean" },
        "sourceId": { "$ref": "#/$defs/id" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "authors", "url", "version", "license", "attribution"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "authors": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "url": { "type": "string", "format": "uri" },
        "version": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "attribution": { "type": "string", "minLength": 1 }
      }
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "names",
        "memberObjectIds",
        "paths",
        "labelAnchor",
        "cultureIds",
        "sourceIds"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "names": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/name" } },
        "memberObjectIds": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/objectId" }
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 4,
            "items": { "$ref": "#/$defs/objectId" }
          }
        },
        "labelAnchor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["objectId"],
          "properties": { "objectId": { "$ref": "#/$defs/objectId" } }
        },
        "cultureIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" }
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    }
  }
}
