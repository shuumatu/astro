POSTGRES_DB=astro
POSTGRES_USER=astro
POSTGRES_PASSWORD=change_me_before_start

MINIO_ROOT_USER=astro
MINIO_ROOT_PASSWORD=change_me_before_start
MINIO_BUCKET=astro-catalog-media

# Local media-service defaults. Production values are documented in deploy/R2_MEDIA_STORAGE.md.
MEDIA_S3_ENDPOINT=http://localhost:9000
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ACCESS_KEY=astro
MEDIA_S3_SECRET_KEY=change_me_before_start
MEDIA_S3_BUCKET=astro-catalog-media
MEDIA_S3_KEY_PREFIX=catalog
MEDIA_S3_PATH_STYLE=true
MEDIA_S3_AUTO_CREATE_BUCKET=true
MEDIA_DELIVERY_MODE=proxy
MEDIA_PUBLIC_BASE_URL=/api/media/assets

ASTRO_ADMIN_USERNAME=admin
ASTRO_ADMIN_PASSWORD=change_me_before_start
ASTRO_JWT_SECRET=replace_with_at_least_32_random_characters
